{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ES2021", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"strict": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/client/**/*", "src/react/**/*", "src/test.ts"]
}
